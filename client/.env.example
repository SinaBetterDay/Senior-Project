# Copy this file to client/.env and replace every placeholder. Only VITE_* values
# are exposed to the browser; do not place database URLs or server secrets here.
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_SUPABASE_ANON_OR_PUBLISHABLE_KEY