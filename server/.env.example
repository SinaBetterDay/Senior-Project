# Copy this file to server/.env and replace every placeholder. Never commit .env.

# App server
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Supabase server credentials. The secret key bypasses RLS; never expose it to
# the browser or place it in a VITE_* variable.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SERVER_SECRET

# Supabase database connection strings. Encode special characters in passwords.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Apify credentials. GitHub Actions uses APIFY_TOKEN as a repository secret and
# APIFY_ACTOR_ID as a repository variable for the scheduled scrape.
APIFY_TOKEN=apify_api_YOUR_TOKEN
APIFY_ACTOR_ID=YOUR_ACTOR_ID

# GitHub Actions runs production schedules. Keep this false in Railway to avoid
# duplicate work; set true only when intentionally using this process as the scheduler.
CRON_ENABLED=false
# LEGISTAR_LOOKBACK_DAYS=30
# APIFY_LOOKBACK_DAYS=14

# Optional isolated database for the real Legistar round-trip integration test.
# RUN_LIVE_LEGISTAR_INTEGRATION=true
LIVE_LEGISTAR_DATABASE_URL=

# Optional entity-resolution provider.
GEMINI_API_KEY=

# Optional weekly email digest provider.
RESEND_API_KEY=