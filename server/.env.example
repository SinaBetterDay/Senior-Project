# Copy to .env and fill in values. Never commit .env.

# ---------------------------------------------------------------------------
# App server
# ---------------------------------------------------------------------------
# Port the Express server listens on (default 3001).
PORT=3001
# Browser origin allowed by CORS — the Vite/React Router dev server (default http://localhost:5173).
CLIENT_ORIGIN=http://localhost:5173
# Set to "production" on Railway to hide stack traces in error responses.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Service-role key (legacy JWT) — server only, bypasses RLS; used for admin auth checks and private Storage. NEVER ship to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: new-style secret key (sb_secret_...) accepted as a fallback for SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Database — Supabase → Project Settings → Database → Connection string
# ---------------------------------------------------------------------------
# 1) DATABASE_URL — "Session pooler" URI (user looks like postgres.<project-ref> @ *.pooler.supabase.com:5432); used by the app at runtime.
# 2) DIRECT_URL — "Direct connection" URI (user postgres @ db.<project-ref>.supabase.co:5432); used by Prisma Migrate.
# Replace [YOUR-PASSWORD] with your DB password — no square brackets. Encode special chars in the password (e.g. $ → %24).
# Append ?sslmode=require if not already present.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Scheduled jobs (node-cron) — see docs/fair/cron-jobs/CONTEXT.md
# ---------------------------------------------------------------------------
# Set to "false" to disable all cron schedules (e.g. locally or in tests). Default true.
CRON_ENABLED=true
# Cron expression for the nightly Legistar agenda sync (default 0 2 * * * = 02:00 daily).
# LEGISTAR_CRON_SCHEDULE=0 2 * * *
# Cron expression for the Apify agenda scrape (default 10 3 * * 1 = Mondays 03:10).
APIFY_AGENDA_CRON_SCHEDULE=10 3 * * 1

# ---------------------------------------------------------------------------
# Agenda scraping (Apify) — PDF-only cities; see docs/fair/agenda-ingestion/CONTEXT.md
# ---------------------------------------------------------------------------
# Apify API token (Apify console → Settings → Integrations).
APIFY_TOKEN=
# Apify actor ID (or username/actor-name) that scrapes city agenda pages.
APIFY_ACTOR_ID=

# ---------------------------------------------------------------------------
# Entity resolution (Gemini) — see docs/fair/entity-resolution/CONTEXT.md
# ---------------------------------------------------------------------------
# Google AI Studio API key; only used for fuzzy name matches scoring 0.7–0.85.
GEMINI_API_KEY=
